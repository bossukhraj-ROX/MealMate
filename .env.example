# Public: Stripe Payment Link URL (safe to expose in frontend)
# This is your existing Stripe Payment Link that redirects to /success after payment.
# Example: https://buy.stripe.com/your_payment_link_id
VITE_STRIPE_PAYMENT_LINK_URL=

# Server-side only: Stripe secret key (already set in Vercel Production env vars)
# Do NOT put this in frontend code or commit it to GitHub.
# STRIPE_SECRET_KEY=

# Server-side only: Vercel Blob read-write token (already configured by Vercel Blob store connection)
# Do NOT put this in frontend code or commit it to GitHub.
# BLOB_READ_WRITE_TOKEN=
